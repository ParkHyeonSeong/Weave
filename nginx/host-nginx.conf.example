# Weave — 호스트 nginx 설정 예시
# 외부 nginx (또는 리버스 프록시)에서 단순 proxy_pass만 하면 됩니다.
# 내부 라우팅(/api → backend, / → frontend)은 컨테이너 nginx가 처리합니다.
#
# .env.production의 EXPOSE_PORT와 맞춰야 함 (기본값: 13000)

server {
    listen 80;
    server_name weave.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name weave.example.com;

    # SSL 인증서 (환경에 맞게 수정)
    ssl_certificate     /etc/letsencrypt/live/weave.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/weave.example.com/privkey.pem;

    client_max_body_size 20M;

    location / {
        proxy_pass http://127.0.0.1:13000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket (채팅, 캔버스 협업)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
