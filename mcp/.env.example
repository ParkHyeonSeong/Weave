# Weave host root (no trailing /api). Tools append /api/... themselves.
# NOTE: over plain http://, the backend's weave_token cookie is sent back ONLY if
# Weave runs with DEBUG=true (non-Secure cookie). Otherwise use an https:// URL,
# or every call will return 401.
WEAVE_BASE_URL=http://localhost:8000

# Dedicated Weave service account used by this MCP server.
# Create it in Weave first (register a user, e.g. mcp-bot), then fill these in mcp/.env (NOT this example file).
WEAVE_SVC_EMAIL=mcp-bot@example.com
WEAVE_SVC_PASSWORD=change-me
