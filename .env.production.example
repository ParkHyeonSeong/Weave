# Weave — Production Environment
# Copy this file to .env.production and fill in your values:
#   cp .env.production.example .env.production
#
# Used by: make prod, make prod-build, etc.

COMPOSE_PROJECT_NAME=weave

# Domain & SSL
DOMAIN=example.com
CERTBOT_EMAIL=admin@example.com

# Ports (internal container ports — Nginx handles 80/443 externally)
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Database (use a strong random password!)
POSTGRES_USER=weave
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_RANDOM_PASSWORD
POSTGRES_DB=weave
DATABASE_URL=postgresql+asyncpg://weave:CHANGE_ME_TO_STRONG_RANDOM_PASSWORD@db:5432/weave

# Backend
LOG_LEVEL=WARNING
DEBUG=false
ALLOWED_ORIGINS=https://example.com

# Frontend
NEXT_PUBLIC_API_URL=https://example.com
