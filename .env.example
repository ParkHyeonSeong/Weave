# Weave — Development Environment
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# For production deployment, see .env.production.example

COMPOSE_PROJECT_NAME=weave

# Ports (change these if already in use on your machine)
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT=5432

# Database
POSTGRES_USER=weave
POSTGRES_PASSWORD=weave
POSTGRES_DB=weave
DATABASE_URL=postgresql+asyncpg://weave:weave@db:5432/weave

# Backend
LOG_LEVEL=DEBUG
DEBUG=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:${BACKEND_PORT}
