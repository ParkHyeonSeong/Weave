# Weave — Development Environment
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# For production deployment, see .env.production.example

COMPOSE_PROJECT_NAME=weave

# Ports (change these if already in use on your machine)
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT=5432

# Database
POSTGRES_USER=weave
POSTGRES_PASSWORD=weave
POSTGRES_DB=weave
DATABASE_URL=postgresql+asyncpg://weave:weave@db:5432/weave

# Backend
LOG_LEVEL=DEBUG
DEBUG=true

# Web Push (VAPID) — 각 인스턴스마다 고유하게 생성 필요
# 생성 방법: docker compose exec backend python -c "from py_vapid import Vapid; import base64; v = Vapid(); v.generate_keys(); raw = v.private_key.private_numbers().private_value.to_bytes(32,'big'); pub = v.private_key.public_key().public_numbers(); x = pub.x.to_bytes(32,'big'); y = pub.y.to_bytes(32,'big'); print(f'VAPID_PRIVATE_KEY={base64.urlsafe_b64encode(raw).decode().rstrip(chr(61))}'); print(f'VAPID_PUBLIC_KEY={base64.urlsafe_b64encode(b\"\\x04\"+x+y).decode().rstrip(chr(61))}')"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.com

# Encryption (SMTP 비밀번호 등 민감 데이터 암호화)
# 생성 방법: openssl rand -hex 32
ENCRYPT_KEY=

# GitHub App 연동 (선택 — PR 기반 태스크 자동 전환). 셋 다 비우면 기능 비활성.
# Webhook URL: https://<your-host>/api/github/webhook
# 권한: Metadata:read, Pull requests:read, Contents:read / 이벤트: Pull request
# GITHUB_APP_PRIVATE_KEY는 base64(PEM) 단일행:
#   Linux: base64 -w0 app.private-key.pem
#   macOS: base64 -i app.private-key.pem | tr -d '\n'
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:${BACKEND_PORT}
